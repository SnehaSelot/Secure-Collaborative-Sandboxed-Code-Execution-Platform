# =============================================================================
# Execution Service — Backend environment variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment mode
# ---------------------------------------------------------------------------
# Options: "production", "dev", "test" (default: "production")
# In production, the backend will refuse to start if COLLAB_JWT_SECRET is
# the default placeholder or is shorter than 32 characters.
ENV=production

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Full async SQLAlchemy connection URL.
# For local dev with Docker Compose, use the service name as the host:
DATABASE_URL=postgresql+asyncpg://sandbox_user:sandbox_pass@postgres:5432/sandbox_db

# ---------------------------------------------------------------------------
# Auth / JWT (B3)
# ---------------------------------------------------------------------------
# HS256 signing secret. Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In production, must be at least 32 characters long and not the placeholder.
# NEVER commit a real secret to source control.
COLLAB_JWT_SECRET=change-me-before-production-min-32-chars-secret

# Token lifetime in seconds (default: 8 hours = 28800)
COLLAB_JWT_EXPIRE_SECONDS=28800

# ---------------------------------------------------------------------------
# CORS / WebSocket origin allow-list (B1)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins. Applied to both the CORS
# middleware (HTTP) and the manual Origin header check in the WS handler.
COLLAB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Collaboration stats endpoint (B6)
# ---------------------------------------------------------------------------
# COLLAB_STATS_ENABLED=true   -> /collab/stats requires a token with 'admin' role
# COLLAB_STATS_ENABLED=false  -> /collab/stats returns 404 (disabled)
COLLAB_STATS_ENABLED=true

# ---------------------------------------------------------------------------
# Collaboration persistence (B5)
# ---------------------------------------------------------------------------
# Set to false to disable DB snapshots (in-memory only; state lost on restart).
COLLAB_PERSIST_ENABLED=true

# How often (seconds) to snapshot a dirty active room while clients are connected.
COLLAB_SNAPSHOT_INTERVAL=30.0

# ---------------------------------------------------------------------------
# Collaboration WebSocket limits (unchanged from original)
# ---------------------------------------------------------------------------
COLLAB_MAX_MESSAGE_BYTES=1048576   # 1 MiB per frame
COLLAB_MAX_ROOM_CLIENTS=20         # max simultaneous connections per room
COLLAB_ROOM_IDLE_SECONDS=60.0      # seconds before an empty room is evicted
COLLAB_CLIENT_QUEUE_MAXSIZE=256    # per-client outbound queue depth

# ---------------------------------------------------------------------------
# Token Redaction & Uvicorn Access Logging Note
# ---------------------------------------------------------------------------
# A logging filter (TokenRedactionFilter) is automatically attached to redact
# sensitive ?token=... query parameters from application and uvicorn access logs.
# In high-security production environments, you can also run uvicorn with
# --no-access-log to disable HTTP access logs entirely:
#   uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log

# ---------------------------------------------------------------------------
# Execution service (unchanged)
# ---------------------------------------------------------------------------
EXECUTOR_POOL_MAX_WORKERS=16
CLEANUP_POOL_MAX_WORKERS=4
REAP_INTERVAL=30
MAX_CONTAINER_AGE=120
WS_QUEUE_MAXSIZE=128
