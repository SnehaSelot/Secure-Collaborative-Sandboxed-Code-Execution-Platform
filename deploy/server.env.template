# =============================================================================
# GlassHouse — AWS EC2 Server Environment Configuration
# Copy this to /opt/glasshouse/backend/.env on the EC2 instance.
# Replace all <PLACEHOLDER> values before starting the service.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment mode
# ---------------------------------------------------------------------------
ENV=production

# ---------------------------------------------------------------------------
# Database (PostgreSQL — running locally on the same EC2 instance)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://glasshouse:<DB_PASSWORD>@localhost:5432/glasshouse_db

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
COLLAB_JWT_SECRET=<GENERATED_JWT_SECRET>
COLLAB_JWT_EXPIRE_SECONDS=28800

# ---------------------------------------------------------------------------
# CORS / WebSocket origin allow-list
# ---------------------------------------------------------------------------
# Allows any IP-based origin (since we're using Elastic IP, no domain).
# For tighter security, replace with your specific Elastic IP:
#   COLLAB_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|<YOUR_ELASTIC_IP>)(:\d+)?
COLLAB_ALLOWED_ORIGIN_REGEX=https?://\d+\.\d+\.\d+\.\d+(:\d+)?

# ---------------------------------------------------------------------------
# Collaboration
# ---------------------------------------------------------------------------
COLLAB_STATS_ENABLED=true
COLLAB_PERSIST_ENABLED=true
COLLAB_SNAPSHOT_INTERVAL=30.0
COLLAB_MAX_MESSAGE_BYTES=1048576
COLLAB_MAX_ROOM_CLIENTS=20
COLLAB_ROOM_IDLE_SECONDS=60.0
COLLAB_CLIENT_QUEUE_MAXSIZE=256

# ---------------------------------------------------------------------------
# Risk Analysis
# ---------------------------------------------------------------------------
RISK_ENABLED=true
# Model auto-discovered from project root — no need to set RISK_MODEL_PATH
RISK_FLAG_THRESHOLD=40
RISK_BLOCK_THRESHOLD=80
RISK_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Execution service — tuned down for t3.micro (1 GB RAM + 2 GB swap)
# ---------------------------------------------------------------------------
EXECUTOR_POOL_MAX_WORKERS=4
CLEANUP_POOL_MAX_WORKERS=2
REAP_INTERVAL=30
MAX_CONTAINER_AGE=120
WS_QUEUE_MAXSIZE=128

